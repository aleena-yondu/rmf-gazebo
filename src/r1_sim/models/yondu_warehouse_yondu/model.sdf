<?xml version='1.0' encoding='utf-8'?>
<!-- Warehouse building model from building_map_tools.
     Wall collision is ENABLED so the robot physically cannot pass through
     shelf bays in Gazebo.  Nav2 uses both the SLAM map (static_layer) and
     live lidar (obstacle_layer) to see these walls and plan around them. -->
<sdf version="1.7">
  <model name="yondu_warehouse_yondu">
    <static>true</static>
    <link name="floor_1">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://yondu_warehouse_yondu/meshes/floor_1.obj</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>0.1 0.1 0.1</specular>
          <pbr>
            <metal>
              <metalness>0.0</metalness>
              <albedo_map>model://yondu_warehouse_yondu/meshes/blue_linoleum.png</albedo_map>
            </metal>
          </pbr>
          <script>
            <uri>model://yondu_warehouse_yondu/meshes/</uri>
            <name>floor_1_Diffuse</name>
          </script>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://yondu_warehouse_yondu/meshes/floor_1.obj</uri>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <collide_bitmask>0x01</collide_bitmask>
          </contact>
        </surface>
      </collision>
    </link>
    <link name="wall_1">
      <visual name="wall_1">
        <geometry>
          <mesh>
            <uri>model://yondu_warehouse_yondu/meshes/wall_1.obj</uri>
          </mesh>
        </geometry>
        <transparency>0.0</transparency>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>0.1 0.1 0.1</specular>
          <pbr>
            <metal>
              <metalness>0.0</metalness>
              <albedo_map>model://yondu_warehouse_yondu/meshes/default.png</albedo_map>
            </metal>
          </pbr>
          <script>
            <uri>model://yondu_warehouse_yondu/meshes/</uri>
            <name>wall_1_Diffuse</name>
          </script>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://yondu_warehouse_yondu/meshes/wall_1.obj</uri>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <collide_bitmask>0x01</collide_bitmask>
          </contact>
        </surface>
      </collision>
      <pose>5.744842791026957 -15.83881460376728 0 0 0 0</pose>
    </link>
  </model>
</sdf>
